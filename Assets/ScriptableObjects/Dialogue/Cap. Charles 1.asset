  _origin: {fileID: 0}
  _name: Cap. Charles
  _sentence: "Muito bem. A Escola Arrais capacita esp\xEDritos aventureiros para
    desbravarem as \xE1guas dos rios e mares desse mund\xE3o. Nosso treinamento de
    Navega\xE7\xE3o tem 2 Est\xE1gios: \r\n\nN\xEDvel 1: Percorrer o percurso no
    menor tempo\r\n\nN\xEDvel 2: Percorrer o percurso no menor tempo desviando dos
    obst\xE1culos"
  _hasChoices: 0
  _choices: []
  _next: {fileID: 0}
  _actions: {fileID: 0}
